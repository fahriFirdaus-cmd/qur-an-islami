      }
    },
    {
      "number": 8,
      "arab": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ",
      "arab_kemenag": "وَاِنَّهٗ لِحُبِّ الْخَيْرِ لَشَدِيْدٌ ۗ",
      "latin": "Wa innahū liḥubbil-khairi lasyadīd(un).",
      "translation_id": "Sesungguhnya cintanya pada harta benar-benar berlebihan.",
      "translation_en": "And indeed he is, in love of wealth, intense.",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/100008.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/100008.mp3",

      }
    },
    {
      "number": 6,
      "arab": "إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ",
      "arab_kemenag": "اِنَّ الْاِنْسَانَ لِرَبِّهٖ لَكَنُوْدٌ ۚ",
      "latin": "Innal-insāna lirabbihī lakanūd(un).",
      "translation_id": "sesungguhnya manusia itu sangatlah ingkar kepada Tuhannya.",
      "translation_en": "Indeed mankind, to his Lord, is ungrateful.",

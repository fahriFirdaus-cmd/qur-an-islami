        "05": "https://cdn.equran.id/audio-partial/Misyari-Rasyid-Al-Afasi/101004.mp3",
        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/101004.mp3"
      }
    },
    {
      "number": 5,
      "arab": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ",
      "arab_kemenag": "وَتَكُوْنُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوْشِۗ",
      "latin": "Wa takūnul-jibālu kal-‘ihnil-manfūsy(i).",
      "translation_id": "dan gunung-gunung seperti bulu yang berhamburan.",
      "translation_en": "And the mountains will be like wool, fluffed up.",

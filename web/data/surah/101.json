      }
    },
    {
      "number": 4,
      "arab": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ",
      "arab_kemenag": "يَوْمَ يَكُوْنُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوْثِۙ",
      "latin": "Yauma yakūnun-nāsu kal-farāsyil-mabṡūṡ(i).",
      "translation_id": "Pada hari itu manusia seperti laron yang beterbangan",
      "translation_en": "It is the Day when people will be like moths, dispersed,",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/101004.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/101004.mp3",
        "03": "https://cdn.equran.id/audio-partial/Abdurrahman-as-Sudais/101004.mp3",

    {
      "number": 3,
      "arab": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ",
      "arab_kemenag": "وَمَآ اَدْرٰىكَ مَا الْقَارِعَةُ ۗ",

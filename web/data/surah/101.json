      }
    },
    {
      "number": 8,
      "arab": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ",
      "arab_kemenag": "وَاَمَّا مَنْ خَفَّتْ مَوَازِيْنُهٗۙ",
      "latin": "Wa ammā man khaffat mawāzīnuh(ū).",
      "translation_id": "Adapun orang yang ringan timbangan (kebaikan)-nya,",

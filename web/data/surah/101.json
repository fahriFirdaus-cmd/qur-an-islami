      }
    },
    {
      "number": 7,
      "arab": "فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ",
      "arab_kemenag": "فَهُوَ فِيْ عِيْشَةٍ رَّاضِيَةٍۗ",
      "latin": "Fa huwa fī ‘īsyatir rāḍiyah(tin).",
      "translation_id": "dia berada dalam kehidupan yang menyenangkan.",
      "translation_en": "He will be in a pleasant life.",

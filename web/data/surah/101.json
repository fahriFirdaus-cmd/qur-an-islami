      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/101003.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/101003.mp3",

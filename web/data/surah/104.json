        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/104003.mp3"
      }
    },
    {
      "number": 4,
      "arab": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ",

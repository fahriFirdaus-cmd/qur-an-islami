        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/104001.mp3"
      }
    },
    {
      "number": 2,
      "arab": "ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ",
      "arab_kemenag": " ۨالَّذِيْ جَمَعَ مَالًا وَّعَدَّدَهٗۙ",
      "latin": "Allażī jama‘a mālaw wa ‘addadah(ū).",
      "translation_id": "yang mengumpulkan harta dan menghitung-hitungnya.",
      "translation_en": "Who collects wealth and [continuously] counts it.",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/104002.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/104002.mp3",

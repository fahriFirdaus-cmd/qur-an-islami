  "ayahs": [
    {
      "number": 1,
      "arab": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ",
      "arab_kemenag": "وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍۙ",
      "latin": "Wailul likulli humazatil-lumazah(tin).",
      "translation_id": "Celakalah setiap pengumpat lagi pencela",
      "translation_en": "Woe to every scorner and mocker",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/104001.mp3",

    },
    {
      "number": 5,
      "arab": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ",
      "arab_kemenag": "وَمَآ اَدْرٰىكَ مَا الْحُطَمَةُ ۗ",
      "latin": "Wa mā adrāka mal-ḥuṭamah(tu).",
      "translation_id": "Tahukah kamu apakah (neraka) Hutamah?",

        "05": "https://cdn.equran.id/audio-partial/Misyari-Rasyid-Al-Afasi/104002.mp3",
        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/104002.mp3"
      }
    },
    {
      "number": 3,
      "arab": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ",
      "arab_kemenag": "يَحْسَبُ اَنَّ مَالَهٗٓ اَخْلَدَهٗۚ",
      "latin": "Yaḥsabu anna mālahū akhladah(ū).",
      "translation_id": "Dia (manusia) mengira bahwa hartanya dapat mengekalkannya.",
      "translation_en": "He thinks that his wealth will make him immortal.",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/104003.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/104003.mp3",

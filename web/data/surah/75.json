        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/075012.mp3"
      }
    },
    {
      "number": 13,
      "arab": "يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ",
      "arab_kemenag": "يُنَبَّؤُا الْاِنْسَانُ يَوْمَىِٕذٍۢ بِمَا قَدَّمَ وَاَخَّرَۗ",
      "latin": "Yunabba'ul-insānu yauma'iżim bimā qaddama wa akhkhar(a).",
      "translation_id": "Pada hari itu diberitakan kepada manusia apa yang telah dia kerjakan dan apa yang telah dia lalaikan.",
      "translation_en": "Man will be informed that Day of what he sent ahead and kept back.",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/075013.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/075013.mp3",

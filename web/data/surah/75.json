    },
    {
      "number": 9,
      "arab": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ",
      "arab_kemenag": "وَجُمِعَ الشَّمْسُ وَالْقَمَرُۙ",
      "latin": "Wa jumi‘asy-syamsu wal-qamar(u).",
      "translation_id": "serta matahari dan bulan dikumpulkan,",

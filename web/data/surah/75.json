        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/075013.mp3"
      }
    },
    {
      "number": 14,
      "arab": "بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ",
      "arab_kemenag": "بَلِ الْاِنْسَانُ عَلٰى نَفْسِهٖ بَصِيْرَةٌۙ",
      "latin": "Balil-insānu ‘alā nafsihī baṣīrah(tun).",
      "translation_id": "Bahkan, manusia menjadi saksi atas dirinya sendiri",
      "translation_en": "Rather, man, against himself, will be a witness,",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/075014.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/075014.mp3",
        "03": "https://cdn.equran.id/audio-partial/Abdurrahman-as-Sudais/075014.mp3",
        "04": "https://cdn.equran.id/audio-partial/Ibrahim-Al-Dossari/075014.mp3",
        "05": "https://cdn.equran.id/audio-partial/Misyari-Rasyid-Al-Afasi/075014.mp3",
        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/075014.mp3"
      }
    },
    {
      "number": 15,
      "arab": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ",
      "arab_kemenag": "وَّلَوْ اَلْقٰى مَعَاذِيْرَهٗۗ",
      "latin": "Wa lau alqā ma‘āżīrah(ū).",
      "translation_id": "walaupun dia mengemukakan alasan-alasan(-nya).",

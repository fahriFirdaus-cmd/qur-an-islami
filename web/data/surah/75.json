  "ayahs": [
    {
      "number": 1,
      "arab": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ",
      "arab_kemenag": "لَآ اُقْسِمُ بِيَوْمِ الْقِيٰمَةِۙ",
      "latin": "Lā uqsimu biyaumil-qiyāmah(ti).",
      "translation_id": "Aku bersumpah demi hari Kiamat.",
      "translation_en": "I swear by the Day of Resurrection",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/075001.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/075001.mp3",

        "05": "https://cdn.equran.id/audio-partial/Misyari-Rasyid-Al-Afasi/075001.mp3",
        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/075001.mp3"
      }
    },
    {
      "number": 2,
      "arab": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ",
      "arab_kemenag": "وَلَآ اُقْسِمُ بِالنَّفْسِ اللَّوَّامَةِ ",
      "latin": "Wa lā uqsimu bin nafsil-lawwāmah(ti).",
      "translation_id": "Aku bersumpah demi jiwa yang sangat menyesali (dirinya sendiri).",
      "translation_en": "And I swear by the reproaching soul [to the certainty of resurrection].",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/075002.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/075002.mp3",
        "03": "https://cdn.equran.id/audio-partial/Abdurrahman-as-Sudais/075002.mp3",
        "04": "https://cdn.equran.id/audio-partial/Ibrahim-Al-Dossari/075002.mp3",
        "05": "https://cdn.equran.id/audio-partial/Misyari-Rasyid-Al-Afasi/075002.mp3",
        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/075002.mp3"
      }
    },
    {
      "number": 3,
      "arab": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ",
      "arab_kemenag": "اَيَحْسَبُ الْاِنْسَانُ اَلَّنْ نَّجْمَعَ عِظَامَهٗ ۗ",
      "latin": "Ayaḥsabul-insānu allan najma‘a ‘iẓāmah(ū).",
      "translation_id": "Apakah manusia mengira bahwa Kami tidak akan mengumpulkan (kembali) tulang-belulangnya?",
      "translation_en": "Does man think that We will not assemble his bones?",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/075003.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/075003.mp3",
        "03": "https://cdn.equran.id/audio-partial/Abdurrahman-as-Sudais/075003.mp3",
        "04": "https://cdn.equran.id/audio-partial/Ibrahim-Al-Dossari/075003.mp3",
        "05": "https://cdn.equran.id/audio-partial/Misyari-Rasyid-Al-Afasi/075003.mp3",
        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/075003.mp3"
      }
    },
    {
      "number": 4,
      "arab": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ",
      "arab_kemenag": "بَلٰى قٰدِرِيْنَ عَلٰٓى اَنْ نُّسَوِّيَ بَنَانَهٗ ",
      "latin": "Balā qādirīna ‘alā an nusawwiya banānah(ū).",
      "translation_id": "Tentu, (bahkan) Kami mampu menyusun (kembali) jari-jemarinya dengan sempurna.",
      "translation_en": "Yes. [We are] Able [even] to proportion his fingertips.",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/075004.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/075004.mp3",
        "03": "https://cdn.equran.id/audio-partial/Abdurrahman-as-Sudais/075004.mp3",
        "04": "https://cdn.equran.id/audio-partial/Ibrahim-Al-Dossari/075004.mp3",
        "05": "https://cdn.equran.id/audio-partial/Misyari-Rasyid-Al-Afasi/075004.mp3",
        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/075004.mp3"
      }
    },
    {
      "number": 5,
      "arab": "بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ",
      "arab_kemenag": "بَلْ يُرِيْدُ الْاِنْسَانُ لِيَفْجُرَ اَمَامَهٗۚ",
      "latin": "Bal yurīdul-insānu liyafjura amāmah(ū).",
      "translation_id": "Akan tetapi, manusia hendak berbuat maksiat terus-menerus.",
      "translation_en": "But man desires to continue in sin.",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/075005.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/075005.mp3",
        "03": "https://cdn.equran.id/audio-partial/Abdurrahman-as-Sudais/075005.mp3",

      }
    },
    {
      "number": 7,
      "arab": "فَإِذَا بَرِقَ ٱلْبَصَرُ",
      "arab_kemenag": "فَاِذَا بَرِقَ الْبَصَرُۙ",
      "latin": "Fa iżā bariqal-baṣar(u).",
      "translation_id": "Apabila mata terbelalak (ketakutan),",
      "translation_en": "So when vision is dazzled",

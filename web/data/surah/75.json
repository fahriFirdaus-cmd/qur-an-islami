        "05": "https://cdn.equran.id/audio-partial/Misyari-Rasyid-Al-Afasi/075005.mp3",
        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/075005.mp3"
      }
    },
    {
      "number": 6,
      "arab": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ",
      "arab_kemenag": "يَسْـَٔلُ اَيَّانَ يَوْمُ الْقِيٰمَةِۗ",
      "latin": "Yas'alu ayyāna yaumul-qiyāmah(ti).",
      "translation_id": "Dia bertanya, “Kapankah hari Kiamat itu?”",
      "translation_en": "He asks, \"When is the Day of Resurrection?\"",

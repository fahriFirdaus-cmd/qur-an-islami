      }
    },
    {
      "number": 10,
      "arab": "يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ",
      "arab_kemenag": "يَقُوْلُ الْاِنْسَانُ يَوْمَىِٕذٍ اَيْنَ الْمَفَرُّۚ",
      "latin": "Yaqūlul-insānu yauma'iżin ainal-mafarr(u).",
      "translation_id": "pada hari itu manusia berkata, “Ke mana tempat lari?”",
      "translation_en": "Man will say on that Day, \"Where is the [place of] escape?\"",

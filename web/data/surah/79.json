      }
    },
    {
      "number": 8,
      "arab": "قُلُوبٌۭ يَوْمَئِذٍۢ وَاجِفَةٌ",
      "arab_kemenag": "قُلُوْبٌ يَّوْمَىِٕذٍ وَّاجِفَةٌۙ",
      "latin": "Qulūbuy yauma'iżiw wājifah(tun).",
      "translation_id": "Hati manusia pada hari itu merasa sangat takut;",
      "translation_en": "Hearts, that Day, will tremble,",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/079008.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/079008.mp3",
        "03": "https://cdn.equran.id/audio-partial/Abdurrahman-as-Sudais/079008.mp3",

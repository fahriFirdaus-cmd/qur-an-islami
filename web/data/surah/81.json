      }
    },
    {
      "number": 9,
      "arab": "بِأَىِّ ذَنۢبٍۢ قُتِلَتْ",
      "arab_kemenag": "بِاَيِّ ذَنْۢبٍ قُتِلَتْۚ",
      "latin": "Bi'ayyi żambin qutilat.",
      "translation_id": "“Karena dosa apa dia dibunuh,”",
      "translation_en": "For what sin she was killed",

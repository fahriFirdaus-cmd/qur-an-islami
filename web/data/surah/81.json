      }
    },
    {
      "number": 13,
      "arab": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
      "arab_kemenag": "وَاِذَا الْجَنَّةُ اُزْلِفَتْۖ",
      "latin": "Wa iżal-jannatu uzlifat.",

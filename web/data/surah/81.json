      }
    },
    {
      "number": 11,
      "arab": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
      "arab_kemenag": "وَاِذَا السَّمَاۤءُ كُشِطَتْۖ",
      "latin": "Wa iżas-samā'u kusyiṭat.",
      "translation_id": "apabila langit dilenyapkan,",
      "translation_en": "And when the sky is stripped away",

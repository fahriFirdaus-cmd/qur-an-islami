      }
    },
    {
      "number": 14,
      "arab": "عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ",
      "arab_kemenag": "عَلِمَتْ نَفْسٌ مَّآ اَحْضَرَتْۗ",

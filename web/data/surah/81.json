        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/081007.mp3"
      }
    },
    {
      "number": 8,
      "arab": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
      "arab_kemenag": "وَاِذَا الْمَوْءٗدَةُ سُىِٕلَتْۖ ",
      "latin": "Wa iżal-mau'ūdatu su'ilat.",
      "translation_id": "apabila bayi-bayi perempuan yang dikubur hidup-hidup ditanya,",
      "translation_en": "And when the girl [who was] buried alive is asked",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/081008.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/081008.mp3",

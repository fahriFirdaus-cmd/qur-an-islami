    {
      "number": 12,
      "arab": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
      "arab_kemenag": "وَاِذَا الْجَحِيْمُ سُعِّرَتْۖ",
      "latin": "Wa iżal-jaḥīmu su‘‘irat.",
      "translation_id": "apabila (neraka) Jahim dinyalakan,",

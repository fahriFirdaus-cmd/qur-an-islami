        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/082008.mp3"
      }
    },
    {
      "number": 9,
      "arab": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ",
      "arab_kemenag": "كَلَّا بَلْ تُكَذِّبُوْنَ بِالدِّيْنِۙ",
      "latin": "Kallā bal tukażżibūna bid-dīn(i).",
      "translation_id": "Jangan sekali-kali begitu! Bahkan, kamu mendustakan hari Pembalasan.",
      "translation_en": "No! But you deny the Recompense.",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/082009.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/082009.mp3",

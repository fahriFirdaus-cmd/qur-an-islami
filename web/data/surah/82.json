      }
    },
    {
      "number": 10,
      "arab": "وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ",
      "arab_kemenag": "وَاِنَّ عَلَيْكُمْ لَحٰفِظِيْنَۙ",
      "latin": "Wa inna ‘alaikum laḥāfiẓīn(a).",
      "translation_id": "Sesungguhnya bagi kamu ada (malaikat-malaikat) pengawas",
      "translation_en": "And indeed, [appointed] over you are keepers,",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/082010.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/082010.mp3",

        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/087003.mp3"
      }
    },
    {
      "number": 4,
      "arab": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ",
      "arab_kemenag": "وَالَّذِيْٓ اَخْرَجَ الْمَرْعٰىۖ ",
      "latin": "Wal-lażī akhrajal-mar‘ā.",
      "translation_id": "dan yang menumbuhkan (rerumputan) padang gembala,",
      "translation_en": "And who brings out the pasture",

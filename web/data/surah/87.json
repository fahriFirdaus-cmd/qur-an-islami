  "ayahs": [
    {
      "number": 1,
      "arab": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى",
      "arab_kemenag": "سَبِّحِ اسْمَ رَبِّكَ الْاَعْلَىۙ ",
      "latin": "Sabbiḥisma rabbikal-a‘lā.",
      "translation_id": "Sucikanlah nama Tuhanmu Yang Maha Tinggi,",
      "translation_en": "Exalt the name of your Lord, the Most High,",

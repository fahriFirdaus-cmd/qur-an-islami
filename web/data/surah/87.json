      }
    },
    {
      "number": 6,
      "arab": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ",
      "arab_kemenag": "سَنُقْرِئُكَ فَلَا تَنْسٰىٓ  ۖ ",
      "latin": "Sanuqri'uka falā tansā.",
      "translation_id": "Kami akan membacakan (Al-Qur’an) kepadamu (Nabi Muhammad) sehingga engkau tidak akan lupa,",
      "translation_en": "We will make you recite, [O Muhammad], and you will not forget,",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/087006.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/087006.mp3",
        "03": "https://cdn.equran.id/audio-partial/Abdurrahman-as-Sudais/087006.mp3",
        "04": "https://cdn.equran.id/audio-partial/Ibrahim-Al-Dossari/087006.mp3",

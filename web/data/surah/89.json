        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/089003.mp3"
      }
    },
    {
      "number": 4,
      "arab": "وَٱلَّيْلِ إِذَا يَسْرِ",
      "arab_kemenag": "وَالَّيْلِ اِذَا يَسْرِۚ",
      "latin": "Wal-laili iżā yasr(i).",
      "translation_id": "dan demi malam apabila berlalu.",
      "translation_en": "And [by] the night when it passes,",
      "audio": {

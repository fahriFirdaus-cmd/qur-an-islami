      }
    },
    {
      "number": 21,
      "arab": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّۭا دَكًّۭا",
      "arab_kemenag": "كَلَّآ اِذَا دُكَّتِ الْاَرْضُ دَكًّا دَكًّاۙ",
      "latin": "Kallā iżā dukkatil-arḍu dakkan dakkā(n).",
      "translation_id": "Jangan sekali-kali begitu! Apabila bumi diguncangkan berturut-turut (berbenturan),",
      "translation_en": "No! When the earth has been leveled - pounded and crushed -",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/089021.mp3",

      "arab_kemenag": "وَّجَاۤءَ رَبُّكَ وَالْمَلَكُ صَفًّا صَفًّاۚ",
      "latin": "Wa jā'a rabbuka wal-malaku ṣaffan ṣaffā(n).",
      "translation_id": "Tuhanmu datang, begitu pula para malaikat (yang datang) berbaris-baris,",
      "translation_en": "And your Lord has come and the angels, rank upon rank,",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/089022.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/089022.mp3",

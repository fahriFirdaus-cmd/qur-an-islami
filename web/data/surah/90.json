        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/090001.mp3"
      }
    },
    {
      "number": 2,
      "arab": "وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ",

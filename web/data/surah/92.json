  "ayahs": [
    {
      "number": 1,
      "arab": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ",
      "arab_kemenag": "وَالَّيْلِ اِذَا يَغْشٰىۙ",
      "latin": "Wal-laili iżā yagsyā.",
      "translation_id": "Demi malam apabila menutupi (cahaya siang),",
      "translation_en": "By the night when it covers",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/092001.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/092001.mp3",

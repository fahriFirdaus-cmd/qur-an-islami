        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/092010.mp3"
      }
    },
    {
      "number": 11,
      "arab": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
      "arab_kemenag": "وَمَا يُغْنِيْ عَنْهُ مَالُهٗٓ اِذَا تَرَدّٰىٓۙ",
      "latin": "Wa mā yugnī ‘anhu māluhū iżā taraddā.",
      "translation_id": "Hartanya tidak bermanfaat baginya apabila dia telah binasa.",
      "translation_en": "And what will his wealth avail him when he falls?",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/092011.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/092011.mp3",

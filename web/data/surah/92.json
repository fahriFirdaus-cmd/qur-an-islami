        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/092011.mp3"
      }
    },
    {
      "number": 12,
      "arab": "إِنَّ عَلَيْنَا لَلْهُدَىٰ",
      "arab_kemenag": "اِنَّ عَلَيْنَا لَلْهُدٰىۖ",
      "latin": "Inna ‘alainā lal-hudā.",
      "translation_id": "Sesungguhnya Kamilah yang (berhak) memberi petunjuk.",
      "translation_en": "Indeed, [incumbent] upon Us is guidance.",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/092012.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/092012.mp3",

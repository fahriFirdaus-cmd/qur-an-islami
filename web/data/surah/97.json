    {
      "number": 3,
      "arab": "لَيْلَةُ ٱلْقَدْرِ خَيْرٌۭ مِّنْ أَلْفِ شَهْرٍۢ",
      "arab_kemenag": "لَيْلَةُ الْقَدْرِ ەۙ خَيْرٌ مِّنْ اَلْفِ شَهْرٍۗ",
      "latin": "Lailatul-qadri khairum min alfi syahr(in).",

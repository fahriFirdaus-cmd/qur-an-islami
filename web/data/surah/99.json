        "04": "https://cdn.equran.id/audio-partial/Ibrahim-Al-Dossari/099007.mp3",
        "05": "https://cdn.equran.id/audio-partial/Misyari-Rasyid-Al-Afasi/099007.mp3",
        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/099007.mp3"
      }
    },
    {
      "number": 8,
      "arab": "وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍۢ شَرًّۭا يَرَهُۥ",
      "arab_kemenag": "وَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَّرَهٗ ࣖ",
      "latin": "Wa may ya‘mal miṡqāla żarratin syarray yarah(ū).",
      "translation_id": "Siapa yang mengerjakan kejahatan seberat zarah, dia akan melihat (balasan)-nya.",

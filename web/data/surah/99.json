        "06": "https://cdn.equran.id/audio-partial/Yasser-Al-Dosari/099003.mp3"
      }
    },
    {
      "number": 4,
      "arab": "يَوْمَئِذٍۢ تُحَدِّثُ أَخْبَارَهَا",
      "arab_kemenag": "يَوْمَىِٕذٍ تُحَدِّثُ اَخْبَارَهَاۙ",
      "latin": "Yauma'iżin tuḥaddiṡu akhbārahā.",
      "translation_id": "Pada hari itu (bumi) menyampaikan berita (tentang apa yang diperbuat manusia di atasnya)",
      "translation_en": "That Day, it will report its news",
      "audio": {
        "01": "https://cdn.equran.id/audio-partial/Abdullah-Al-Juhany/099004.mp3",
        "02": "https://cdn.equran.id/audio-partial/Abdul-Muhsin-Al-Qasim/099004.mp3",
